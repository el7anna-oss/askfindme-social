# Copy this file to .env and fill it in. NEVER commit .env and never paste its values in chat.

# Free key from https://developer.ticketmaster.com (create an account, then "My Apps")
TICKETMASTER_API_KEY=

# Markets to pull events from (Ticketmaster country codes, comma separated)
MARKETS=US,GB,DE,ES,NL,IE

# Look-ahead window for events, in days
DAYS_FROM=3
DAYS_TO=45

# Shown on the last slide and in the caption
SITE=askfindme.com
CONTACT_EMAIL=support@askfindme.com
# Digits only with country code, e.g. 96170123456. Leave empty to hide WhatsApp.
WHATSAPP=

# Event types to include (Ticketmaster segments, comma separated)
CATEGORIES=Music,Sports,Arts & Theatre

# photo = event image in a framed card; plain = text-only branded cards, no Ticketmaster photos
IMAGE_MODE=photo

# ---- Publishing to Instagram (fill these only when the Meta app is ready) ----
# Instagram professional account ID (a long number) and access token from the Meta developer app.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Public web address that serves the draft images (the GitHub raw address of the posts folder), no trailing slash:
# https://raw.githubusercontent.com/<github-user>/askfindme-social/main/posts
PUBLIC_BASE_URL=

# ---- Approval email (optional) ----
RESEND_API_KEY=
NOTIFY_EMAIL=
